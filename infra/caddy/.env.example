# Valores de ejemplo. Rellena /etc/caddy/.env dentro del LXC.
# Zona del certificado comodín, sin el prefijo *.
HOMELAB_ZONE=home.example.org
DUCKDNS_OVERRIDE_DOMAIN=tu-subdominio.duckdns.org
DUCKDNS_API_TOKEN=

# HOST es el nombre completo. UPSTREAM es la dirección con puerto, sin esquema.
PROXMOX_HOST=proxmox.home.example.org
PROXMOX_UPSTREAM=192.0.2.20:8006
AUTHENTIK_HOST=auth.home.example.org
AUTHENTIK_UPSTREAM=192.0.2.30:9000

# Aplicaciones de la VM Debian
MUSIC_HOST=armonia.home.example.org
MUSIC_UPSTREAM=192.0.2.40:18400
JELLYFIN_HOST=jellyfin.home.example.org
JELLYFIN_UPSTREAM=192.0.2.40:8096
SEERR_HOST=seerr.home.example.org
SEERR_UPSTREAM=192.0.2.40:5055
VAULTWARDEN_HOST=vaultwarden.home.example.org
VAULTWARDEN_UPSTREAM=192.0.2.40:8222
IMMICH_HOST=immich.home.example.org
IMMICH_UPSTREAM=192.0.2.40:2283
OVERLEAF_HOST=overleaf.home.example.org
OVERLEAF_UPSTREAM=192.0.2.40:8082
