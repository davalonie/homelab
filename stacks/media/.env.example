# Dirección de la VM para Jellyfin y Seerr. Para Caddy usa la IP privada de la VM.
MEDIA_BIND=127.0.0.1
MEDIA_UID=1000
MEDIA_GID=1000
TZ=Europe/Madrid

# Configuración en disco local. Descargas y biblioteca en un mismo sistema de archivos.
MEDIA_CONFIG_DIR=./runtime/config
MEDIA_CACHE_DIR=./runtime/cache
MEDIA_DATA_DIR=./runtime/data

# VPNBook por OpenVPN (Francia, TCP 443). Prepara los datos con scripts/vpnbook.py.
COMPOSE_FILE=compose.yaml:compose.vpnbook.yaml
MEDIA_VPNBOOK_SERVER=fr231.vpnbook.com

# Para usar un perfil WireGuard propio, establece COMPOSE_FILE=compose.yaml.
# MEDIA_WG_FILE=./secrets/wg0.conf
