# Docker Compose lee estas variables desde .env en el directorio del stack.
# Vacío usa la referencia fijada en compose.yaml y versions.lock.
MUSIC_IMAGE=
MUSIC_RUNTIME_DIR=./runtime
MUSIC_UID=1000
MUSIC_GID=1000
# Para Caddy en otro LXC, usa la dirección privada de la VM accesible desde él.
MUSIC_BIND=127.0.0.1
MUSIC_PORT=18400
MUSIC_COOKIE_SECURE=true
# Sustituye por el origen HTTPS de tu instalación al utilizar el móvil.
MUSIC_PUBLIC_ORIGIN=https://music.example.org
MUSIC_YOUTUBE_CAPABILITIES=
MUSIC_SEARCH_BACKEND=legacy
# Ruta opcional dentro de /app/config para exclusiones de recomendaciones.
MUSIC_DISCOVERY_QUARANTINE_FILE=
# Para una tercera cuenta en Koito, habilita el perfil third-user.
COMPOSE_PROFILES=

# Solo con compose.authentik.yaml. Copia el issuer exacto del discovery.
# Ejemplos: https://identity.example.org/application/o/armonia/ y cliente music-example.
MUSIC_OIDC_ISSUER=
MUSIC_OIDC_CLIENT_ID=
# Grupo que debe aparecer en el ID token. Vacío delega el control de grupo en Authentik.
MUSIC_OIDC_GROUP=
# Elige un CIDR Docker libre y una IPv4 fija de esa red para el contenedor music.
# Valores de documentación. Sustitúyelos por una red disponible en tu instalación.
MUSIC_LIBRARY_SUBNET=192.0.2.0/28
MUSIC_PROXY_IP=192.0.2.2
# Pool dinámico dentro de library, separado de la IP de music.
MUSIC_LIBRARY_IP_RANGE=192.0.2.8/29
# Solo para una compilación Android con applicationId personalizado.
# MUSIC_ANDROID_APPLICATION_ID=io.github.davalonie.armonia
