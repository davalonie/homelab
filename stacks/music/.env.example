# Docker Compose lee estas variables desde .env en el directorio del stack.
# Vacío usa la referencia fijada en compose.yaml y versions.lock.
MUSIC_IMAGE=
MUSIC_RUNTIME_DIR=./runtime
MUSIC_UID=1000
MUSIC_GID=1000
# Para Caddy en otro LXC, usa la dirección privada de la VM accesible desde él.
MUSIC_BIND=127.0.0.1
MUSIC_PORT=18400
MUSIC_COOKIE_SECURE=true
# Sustituye por el origen HTTPS de tu instalación al utilizar el móvil.
MUSIC_PUBLIC_ORIGIN=https://music.example.org
MUSIC_YOUTUBE_CAPABILITIES=
MUSIC_SEARCH_BACKEND=legacy
# Ruta opcional dentro de /app/config para exclusiones de recomendaciones.
MUSIC_DISCOVERY_QUARANTINE_FILE=
# Para una tercera cuenta en Koito, habilita el perfil third-user.
COMPOSE_PROFILES=
