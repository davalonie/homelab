# Copiar a ~/.config/armonia-copia.env y ajustar. No contiene secretos.
# Carpeta de un disco DISTINTO al de la instalación (externo, otro equipo montado…).
ARMONIA_DEST=/media/USUARIO/DISCO/armonia-copias
ARMONIA_INFRA=/ruta/a/homelab/stacks/music
# Un Python con el paquete «cryptography».
ARMONIA_PYTHON=/ruta/a/venv/bin/python
# Opcional: la clave de firma de la APK viaja cifrada dentro del estado.
ARMONIA_FIRMA=
# Copias de estado que se conservan (la música es un espejo, no tiene versiones).
ARMONIA_KEEP=14
